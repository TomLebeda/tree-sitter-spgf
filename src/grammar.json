{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "spgf",
  "rules": {
    "grammar": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "ruleDefinition"
      }
    },
    "comment": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "//"
            },
            {
              "type": "PATTERN",
              "value": ".*"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "/*"
            },
            {
              "type": "PATTERN",
              "value": "[^*]*\\*+([^/*][^*]*\\*+)*"
            },
            {
              "type": "STRING",
              "value": "/"
            }
          ]
        }
      ]
    },
    "ruleDefinition": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "public"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "ruleHeader"
        },
        {
          "type": "SYMBOL",
          "name": "ruleBody"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "ruleHeader": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "ruleName"
        },
        {
          "type": "STRING",
          "value": "="
        }
      ]
    },
    "ruleName": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "$"
        },
        {
          "type": "PATTERN",
          "value": "[\\p{L}0-9_]+"
        }
      ]
    },
    "ruleBody": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "ruleAlternative"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "|"
              },
              {
                "type": "SYMBOL",
                "name": "ruleAlternative"
              }
            ]
          }
        }
      ]
    },
    "ruleAlternative": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "ruleElement"
      }
    },
    "ruleElement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "token"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "specialGarbage"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "repeatOperator"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "grammarTag"
              }
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "specialVoid"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "specialNull"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "grammarTag"
              }
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "specialEnd"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "grammarTag"
              }
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "specialBegin"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "grammarTag"
              }
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "ruleRef"
        },
        {
          "type": "SYMBOL",
          "name": "sequence"
        }
      ]
    },
    "specialGarbage": {
      "type": "STRING",
      "value": "$GARBAGE"
    },
    "specialVoid": {
      "type": "STRING",
      "value": "$VOID"
    },
    "specialNull": {
      "type": "STRING",
      "value": "$NULL"
    },
    "specialEnd": {
      "type": "STRING",
      "value": "$END"
    },
    "specialBegin": {
      "type": "STRING",
      "value": "$BEGIN"
    },
    "token": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "[\\p{L}0-9.\\-_:]"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "repeatOperator"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "grammarTag"
          }
        }
      ]
    },
    "repeatOperator": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "styleSpec"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "repeatShortcut"
            },
            {
              "type": "SYMBOL",
              "name": "repeatFull"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "styleSpec": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "styleShortcut"
        },
        {
          "type": "STRING",
          "value": ":"
        }
      ]
    },
    "styleShortcut": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "L"
        },
        {
          "type": "STRING",
          "value": "G"
        },
        {
          "type": "STRING",
          "value": "T"
        }
      ]
    },
    "repeatShortcut": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "*"
        },
        {
          "type": "STRING",
          "value": "+"
        }
      ]
    },
    "repeatFull": {
      "type": "PATTERN",
      "value": "[0-9]+-[0-9]*"
    },
    "grammarTag": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "braceOpen"
        },
        {
          "type": "PATTERN",
          "value": "[^}]*"
        },
        {
          "type": "SYMBOL",
          "name": "braceClose"
        }
      ]
    },
    "braceOpen": {
      "type": "STRING",
      "value": "{"
    },
    "braceClose": {
      "type": "STRING",
      "value": "}"
    },
    "ruleRef": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "ruleName"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "repeatOperator"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "grammarTag"
          }
        }
      ]
    },
    "sequence": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "bracedSequence"
            },
            {
              "type": "SYMBOL",
              "name": "optionalSequence"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "repeatOperator"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "grammarTag"
          }
        }
      ]
    },
    "bracedSequence": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "ruleBody"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "optionalSequence": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "SYMBOL",
          "name": "ruleBody"
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "SYMBOL",
      "name": "comment"
    },
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "PATTERN",
      "value": "\\n"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}