{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "spgf",
      "camelcase": "Spgf",
      "title": "Spgf",
      "scope": "source.spgf",
      "file-types": [
        "spgf"
      ],
      "injection-regex": "^spgf$",
      "class-name": "TreeSitterSpgf"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "parser for SPGF grammar files",
    "authors": [
      {
        "name": "Tomáš Lebeda",
        "email": "tom.lebeda@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/TomLebeda/tree-sitter-spgf"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
